#!/usr/bin/env bash
set -e

echo "Setting up Pi Harness..."

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PI_CODING_AGENT_DIR="$REPO_ROOT/.pi/agent"

# Check Node version
if ! command -v node >/dev/null 2>&1; then
  echo "Error: Node.js is not installed."
  exit 1
fi
echo "✓ Node.js installed: $(node -v)"

# Check Pi
if ! command -v pi >/dev/null 2>&1; then
  echo "Installing pi globally..."
  npm install -g @earendil-works/pi-coding-agent
fi
echo "✓ Pi installed: $(pi --version)"

# Initialize git submodules if any exist
if [ -f "$REPO_ROOT/.gitmodules" ]; then
  echo "Initializing git submodules..."
  git -C "$REPO_ROOT" submodule sync --recursive
  git -C "$REPO_ROOT" submodule update --init --recursive
fi

# Create required directories
mkdir -p "$REPO_ROOT/skills" "$REPO_ROOT/extensions" "$REPO_ROOT/agents" "$REPO_ROOT/prompts"
mkdir -p "$PI_CODING_AGENT_DIR/npm" "$PI_CODING_AGENT_DIR/extensions"

# Symlink skills, agents, and prompts to Pi's discovery path using relative paths
ln -sfn "../../skills" "$PI_CODING_AGENT_DIR/skills"
echo "✓ Skills linked"
ln -sfn "../../agents" "$PI_CODING_AGENT_DIR/agents"
echo "✓ Agents linked"
ln -sfn "../../prompts" "$PI_CODING_AGENT_DIR/prompts"
echo "✓ Prompts linked"

# Symlink local extensions into .pi/agent/extensions
for ext_dir in "$REPO_ROOT/extensions"/*/; do
  if [ -d "$ext_dir" ]; then
    ext_name="$(basename "$ext_dir")"
    ln -sfn "../../../extensions/$ext_name" "$PI_CODING_AGENT_DIR/extensions/$ext_name"
  fi
done
echo "✓ Extensions linked"

# Install extensions via pi command
echo "Installing extensions..."
"$REPO_ROOT/bin/pi" extensions install

# Install dependencies for local extensions
echo "Installing local extension dependencies..."
for ext_dir in "$REPO_ROOT/extensions"/*/; do
  if [ -f "${ext_dir}package.json" ]; then
    echo "Installing dependencies for $(basename "$ext_dir")..."
    (cd "$ext_dir" && npm install)
  fi
done

# Optional: Antigravity OpenAI Bridge setup for Graphify deep extraction
echo ""
read -r -p "Do you want to configure Antigravity OAuth bridges (graphify deep extraction & browser-use)? (y/N): " enable_antigravity_bridge || enable_antigravity_bridge="n"

if [[ "$enable_antigravity_bridge" =~ ^[Yy]$ ]]; then
  echo "Setting up Antigravity OAuth bridges..."
  mkdir -p "$HOME/.local/bin" "$HOME/.graphify"

  # Install bridge script and graphify-deep wrapper
  cp "$REPO_ROOT/scripts/antigravity-openai-bridge" "$HOME/.local/bin/antigravity-openai-bridge"
  chmod +x "$HOME/.local/bin/antigravity-openai-bridge"
  cp "$REPO_ROOT/scripts/graphify-deep" "$HOME/.local/bin/graphify-deep"
  chmod +x "$HOME/.local/bin/graphify-deep"

  # Install browser-use antigravity bridge and runner
  if [ -f "$REPO_ROOT/scripts/browser-use-antigravity-bridge" ]; then
    cp "$REPO_ROOT/scripts/browser-use-antigravity-bridge" "$HOME/.local/bin/browser-use-antigravity-bridge"
    chmod +x "$HOME/.local/bin/browser-use-antigravity-bridge"
    echo "✓ browser-use-antigravity-bridge installed"
  fi
  if [ -f "$REPO_ROOT/scripts/browser-use-run" ]; then
    cp "$REPO_ROOT/scripts/browser-use-run" "$HOME/.local/bin/browser-use-run"
    chmod +x "$HOME/.local/bin/browser-use-run"
    echo "✓ browser-use-run installed"
  fi

  # Install browser-use CLI and Playwright dependencies via uv if available
  if command -v uv >/dev/null 2>&1; then
    echo "Installing browser-use tools and playwright chromium via uv..."
    uv tool install --with playwright "browser-use" --force >/dev/null 2>&1 || true
    uv run --with browser-use --with playwright playwright install chromium >/dev/null 2>&1 || true
    echo "✓ browser-use CLI & Playwright Chromium installed"
  fi

  # Configure ~/.graphify/providers.json
  PROVIDERS_FILE="$HOME/.graphify/providers.json"
  if [[ ! -f "$PROVIDERS_FILE" ]] || ! grep -q '"antigravity"' "$PROVIDERS_FILE" 2>/dev/null; then
    echo "Configuring $PROVIDERS_FILE..."
    cat << 'EOF' > "$PROVIDERS_FILE"
{
  "antigravity": {
    "base_url": "http://127.0.0.1:51155/v1",
    "default_model": "gemini-3.8-flash",
    "env_key": "ANTIGRAVITY_DUMMY_KEY",
    "pricing": {
      "input": 0.0,
      "output": 0.0
    },
    "temperature": 0.0,
    "max_tokens": 8192,
    "vision": false
  }
}
EOF
  fi

  # Append instruction to AGENTS.local.md if it exists or create it from example
  AGENTS_LOCAL="$REPO_ROOT/AGENTS.local.md"
  GRAPHIFY_INSTRUCTION='- For `graphify --mode deep`: ensure `~/.local/bin/antigravity-openai-bridge` runs on port 51155 and run with `ANTIGRAVITY_DUMMY_KEY="dummy" graphify extract . --backend antigravity --mode deep` (uses Antigravity OAuth, no API key required).'
  BROWSER_USE_INSTRUCTION='- For `browser-use`: ensure `~/.local/bin/browser-use-antigravity-bridge` runs on port 51156 (or use `browser-use-run script.py`). Point ChatOpenAI to http://127.0.0.1:51156/v1 with dummy API key (uses Antigravity OAuth, no API key required).'

  if [[ ! -f "$AGENTS_LOCAL" ]]; then
    cp "$REPO_ROOT/AGENTS.local.md.example" "$AGENTS_LOCAL"
    echo "✓ Created AGENTS.local.md from example"
  fi
  if ! grep -Fq "antigravity-openai-bridge" "$AGENTS_LOCAL"; then
    echo "" >> "$AGENTS_LOCAL"
    echo "$GRAPHIFY_INSTRUCTION" >> "$AGENTS_LOCAL"
    echo "✓ Added graphify Antigravity bridge instruction to AGENTS.local.md"
  fi
  if ! grep -Fq "browser-use-antigravity-bridge" "$AGENTS_LOCAL"; then
    echo "" >> "$AGENTS_LOCAL"
    echo "$BROWSER_USE_INSTRUCTION" >> "$AGENTS_LOCAL"
    echo "✓ Added browser-use Antigravity bridge instruction to AGENTS.local.md"
  fi

  echo "✓ Antigravity bridge scripts installed in ~/.local/bin"
  echo "  - Graphify deep: use 'graphify-deep [dir]' or bridge on port 51155"
  echo "  - Browser-use:   use 'browser-use-run script.py' or bridge on port 51156"
fi

echo ""
echo "Setup complete! Run with: ./bin/pi"
